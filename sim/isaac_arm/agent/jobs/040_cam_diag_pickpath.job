# 11/11 시뮬 카메라 빈 화면 진단 (집기 경로 = Residual, r20d). 031·033·034 는 첫 look(시작 0.3 s, 8 env 동시)에서 중단 → RTX 예열 전일 수 있음
#   WAIT 2 s 로 늘림 + 카메라 점검(1 s 마다 wrist/top/percep 단색·깊이 검사, 4회) + 빈 장 40 연속까지 허용, 순간별 16장
MODE=percep-dump
NZ2_CHASSIS=r20d
NZ2_LIE_ROLL=1
NZ2_WAIT_S=2.0
NZ2_CAM_CHECK=1
NZ2_PERCEP_BLANK_ABORT=40
NZ2_PERCEP_MAX=16
STAGE=3
