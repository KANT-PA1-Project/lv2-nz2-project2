# =============================================================
# 패키지 : nz2_interfaces
# 파일   : srv/SetRobotMode.srv
# 레이어 : interface
# 역할   : 로봇 동작 모드 변경 요청 (대기 / 실행 / 비상정지)
#
# [ROS2 메모] srv = 요청 1번 → 응답 1번. "---" 위가 요청, 아래가 응답
# [안전] ESTOP 요청은 어떤 상태에서도 받아들여야 한다
# =============================================================

uint8 MODE_IDLE=0
uint8 MODE_RUN=1
uint8 MODE_ESTOP=2

# 바꾸려는 모드
uint8 mode
---
# 바뀌었으면 true
bool success
