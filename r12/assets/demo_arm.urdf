<?xml version='1.0' encoding='utf-8'?>
<robot name="practice_demo_arm">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 .05" />
      <mass value="2" />
      <inertia ixx="0.004066666666666667" iyy="0.004066666666666667" izz="0.0048" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 .05" />
      <geometry>
        <box size="0.12 0.12 0.1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 .05" />
      <geometry>
        <box size="0.12 0.12 0.1" />
      </geometry>
    </collision>
  </link>
  <link name="shoulder">
    <inertial>
      <origin xyz="0 0 .04" />
      <mass value="0.5" />
      <inertia ixx="0.0004166666666666667" iyy="0.0004166666666666667" izz="0.0003" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 .04" />
      <geometry>
        <box size="0.06 0.06 0.08" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 .04" />
      <geometry>
        <box size="0.06 0.06 0.08" />
      </geometry>
    </collision>
  </link>
  <link name="upper_arm">
    <inertial>
      <origin xyz=".125 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.00016" iyy="0.003205" izz="0.003205" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz=".125 0 0" />
      <geometry>
        <box size="0.25 0.04 0.04" />
      </geometry>
    </visual>
    <collision>
      <origin xyz=".125 0 0" />
      <geometry>
        <box size="0.25 0.04 0.04" />
      </geometry>
    </collision>
  </link>
  <link name="forearm">
    <inertial>
      <origin xyz=".10 0 0" />
      <mass value="0.4" />
      <inertia ixx="8.166666666666668e-05" iyy="0.0013741666666666668" izz="0.0013741666666666668" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz=".10 0 0" />
      <geometry>
        <box size="0.2 0.035 0.035" />
      </geometry>
    </visual>
    <collision>
      <origin xyz=".10 0 0" />
      <geometry>
        <box size="0.2 0.035 0.035" />
      </geometry>
    </collision>
  </link>
  <link name="tool0">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="5.208333333333335e-06" iyy="5.208333333333335e-06" izz="5.208333333333335e-06" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.025 0.025 0.025" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.025 0.025 0.025" />
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link" />
    <child link="shoulder" />
    <origin xyz="0 0 .10" />
    <axis xyz="0 0 1" />
    <limit lower="-2.5" upper="2.5" effort="15" velocity="1" />
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="shoulder" />
    <child link="upper_arm" />
    <origin xyz="0 0 .08" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5" upper="1.5" effort="15" velocity="1" />
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz=".25 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2" upper="2" effort="8" velocity="1" />
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="forearm" />
    <child link="tool0" />
    <origin xyz=".20 0 0" />
  </joint>
</robot>