                def Mesh "Surface" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    uniform bool doubleSided = 1
                    int[] faceVertexCounts = [4]
                    int[] faceVertexIndices = [0, 1, 2, 3]
                    rel material:binding = </World/FixtureMaterials/Tag0>
                    point3f[] points = [(-0.01, -0.01, 0), (0.01, -0.01, 0), (0.01, 0.01, 0), (-0.01, 0.01, 0)]
                    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                        interpolation = "faceVarying"
                    )
                }
            }

            def Xform "bottom"
            {
                matrix4d xformOp:transform = ( (-1, 0, -1.2246467991473532e-16, 0), (0, 1, 0, 0), (1.2246467991473532e-16, 0, -1, 0), (0, 0, -0.030029999999999998, 1) )
                uniform token[] xformOpOrder = ["xformOp:transform"]

                def Mesh "Surface" (
